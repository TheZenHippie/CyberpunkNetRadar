<Window x:Class="CyberPunkNetRadar.UI.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Radar Accent Color" 
        Height="360" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0B0F19"
        Foreground="#FFFFFF"
        WindowStyle="ToolWindow">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Segoe UI, sans-serif"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#A0C0E0"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Consolas, Segoe UI, sans-serif"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#00F0FF"/>
            <Setter Property="Background" Value="#141E30"/>
            <Setter Property="BorderBrush" Value="#00F0FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2500F0FF"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="CUSTOM HUD ACCENT COLOR" FontWeight="Bold" Foreground="#00F0FF" FontSize="14" Margin="0,0,0,12"/>

        <!-- Color Preview & Hex Input -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Live Color Preview Swatch -->
            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="6" BorderBrush="#80FFFFFF" BorderThickness="1" HorizontalAlignment="Left">
                <Border.Background>
                    <SolidColorBrush x:Name="PreviewColorBrush" Color="#00F0FF"/>
                </Border.Background>
            </Border>

            <!-- Hex Input -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Hex Color Code (#RRGGBB):" Margin="0,0,0,4"/>
                <TextBox x:Name="HexInputTextBox"
                         Text="#00F0FF"
                         FontFamily="Consolas"
                         FontSize="14"
                         FontWeight="Bold"
                         Background="#101726"
                         Foreground="#FFFFFF"
                         BorderBrush="#3000F0FF"
                         BorderThickness="1"
                         Padding="6,4"
                         TextChanged="HexInputTextBox_TextChanged"/>
            </StackPanel>
        </Grid>

        <!-- RGB Sliders -->
        <StackPanel Grid.Row="2" VerticalAlignment="Top" Margin="0,0,0,10">
            <!-- Red Slider -->
            <DockPanel Margin="0,2,0,4">
                <TextBlock Text="R" Width="20" FontWeight="Bold" Foreground="#FF4466"/>
                <TextBlock x:Name="RedValText" Text="0" Width="35" DockPanel.Dock="Right" TextAlignment="Right"/>
                <Slider x:Name="RedSlider" Minimum="0" Maximum="255" Value="0" ValueChanged="RgbSlider_ValueChanged"/>
            </DockPanel>

            <!-- Green Slider -->
            <DockPanel Margin="0,2,0,4">
                <TextBlock Text="G" Width="20" FontWeight="Bold" Foreground="#00FF88"/>
                <TextBlock x:Name="GreenValText" Text="240" Width="35" DockPanel.Dock="Right" TextAlignment="Right"/>
                <Slider x:Name="GreenSlider" Minimum="0" Maximum="255" Value="240" ValueChanged="RgbSlider_ValueChanged"/>
            </DockPanel>

            <!-- Blue Slider -->
            <DockPanel Margin="0,2,0,4">
                <TextBlock Text="B" Width="20" FontWeight="Bold" Foreground="#00CCFF"/>
                <TextBlock x:Name="BlueValText" Text="255" Width="35" DockPanel.Dock="Right" TextAlignment="Right"/>
                <Slider x:Name="BlueSlider" Minimum="0" Maximum="255" Value="255" ValueChanged="RgbSlider_ValueChanged"/>
            </DockPanel>

            <!-- Preset Swatches -->
            <TextBlock Text="Preset Swatches:" Margin="0,10,0,6" FontSize="11" Foreground="#80A0C0"/>
            <WrapPanel>
                <Button Content="" Width="24" Height="24" Margin="0,0,6,6" Background="#00F0FF" Tag="#00F0FF" Click="PresetSwatch_Click"/>
                <Button Content="" Width="24" Height="24" Margin="0,0,6,6" Background="#00FF66" Tag="#00FF66" Click="PresetSwatch_Click"/>
                <Button Content="" Width="24" Height="24" Margin="0,0,6,6" Background="#FF007F" Tag="#FF007F" Click="PresetSwatch_Click"/>
                <Button Content="" Width="24" Height="24" Margin="0,0,6,6" Background="#FFB000" Tag="#FFB000" Click="PresetSwatch_Click"/>
                <Button Content="" Width="24" Height="24" Margin="0,0,6,6" Background="#FF2244" Tag="#FF2244" Click="PresetSwatch_Click"/>
                <Button Content="" Width="24" Height="24" Margin="0,0,6,6" Background="#A040FF" Tag="#A040FF" Click="PresetSwatch_Click"/>
                <Button Content="" Width="24" Height="24" Margin="0,0,6,6" Background="#F0F0F0" Tag="#F0F0F0" Click="PresetSwatch_Click"/>
                <Button Content="" Width="24" Height="24" Margin="0,0,6,6" Background="#00FFFF" Tag="#00FFFF" Click="PresetSwatch_Click"/>
                <Button Content="" Width="24" Height="24" Margin="0,0,6,6" Background="#FF7700" Tag="#FF7700" Click="PresetSwatch_Click"/>
            </WrapPanel>
        </StackPanel>

        <!-- Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="Apply Color" IsDefault="True" Click="Apply_Click"/>
        </StackPanel>
    </Grid>
</Window>

