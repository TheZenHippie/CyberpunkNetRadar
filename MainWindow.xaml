<Window x:Class="CyberPunkNetRadar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="Cyberpunk Network Radar"
        Icon="icon.png"
        Height="460" Width="460"
        MinHeight="260" MinWidth="260"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        SizeChanged="Window_SizeChanged"
        ContextMenuOpening="Window_ContextMenuOpening">

    <Window.ContextMenu>
        <ContextMenu x:Name="MainContextMenu"
                     PreviewMouseMove="MainContextMenu_PreviewMouseMove"
                     PreviewMouseLeftButtonDown="MainContextMenu_PreviewMouseLeftButtonDown"
                     Closed="MainContextMenu_Closed">

            <!-- Sweep Speed Controls -->
            <MenuItem StaysOpenOnClick="True">
                <MenuItem.Header>
                    <StackPanel Width="220" Margin="0,2">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Sweep Speed (Duration)" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SweepSpeedValueText" Text="10.0s" DockPanel.Dock="Right" Foreground="#666666"/>
                        </DockPanel>
                        <Slider x:Name="SweepSpeedSlider"
                                Minimum="3.0" Maximum="10.0" Value="10.0"
                                SmallChange="0.5" LargeChange="1.0"
                                Margin="0,6,0,2"
                                PreviewMouseWheel="Slider_PreviewMouseWheel"
                                ValueChanged="SweepSpeedSlider_ValueChanged"/>
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem Header="Sweep Presets...">
                <MenuItem Header="Ultra Fast (3 Seconds)" Click="SweepPreset_Click" Tag="3.0"/>
                <MenuItem Header="Fast (5 Seconds)" Click="SweepPreset_Click" Tag="5.0"/>
                <MenuItem Header="Medium (8 Seconds)" Click="SweepPreset_Click" Tag="8.0"/>
                <MenuItem Header="Standard (10 Seconds)" Click="SweepPreset_Click" Tag="10.0" IsChecked="True"/>
            </MenuItem>
            <Separator/>

            <!-- Radar Range Mode -->
            <MenuItem x:Name="RangeModeMenuItem" Header="Radar Range Mode">
                <MenuItem x:Name="RangeAutoMenuItem" Header="Auto-Scale (Dynamic)" Click="RangeMode_Click" Tag="0"/>
                <Separator/>
                <MenuItem x:Name="Range5MenuItem" Header="5 ms Ultra-Precision Range (1ms Rings)" Click="RangeMode_Click" Tag="5"/>
                <MenuItem x:Name="Range30MenuItem" Header="30 ms Standard Range (5ms Rings)" Click="RangeMode_Click" Tag="30" IsChecked="True"/>
                <MenuItem x:Name="Range60MenuItem" Header="60 ms Extended Range (10ms Rings)" Click="RangeMode_Click" Tag="60"/>
                <MenuItem x:Name="Range100MenuItem" Header="100 ms Long Range (20ms Rings)" Click="RangeMode_Click" Tag="100"/>
                <MenuItem x:Name="Range300MenuItem" Header="300 ms Global Range (50ms Rings)" Click="RangeMode_Click" Tag="300"/>
            </MenuItem>

            <!-- Blip Fade Duration -->
            <MenuItem StaysOpenOnClick="True">
                <MenuItem.Header>
                    <StackPanel Width="220" Margin="0,2">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Phosphor Blip Fade" FontWeight="SemiBold"/>
                            <TextBlock x:Name="FadeDurationValueText" Text="5.0s" DockPanel.Dock="Right" Foreground="#666666"/>
                        </DockPanel>
                        <Slider x:Name="FadeDurationSlider"
                                Minimum="2.0" Maximum="10.0" Value="5.0"
                                SmallChange="0.5" LargeChange="1.0"
                                Margin="0,6,0,2"
                                PreviewMouseWheel="Slider_PreviewMouseWheel"
                                ValueChanged="FadeDurationSlider_ValueChanged"/>
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <Separator/>

            <!-- HUD Color Palette with Visual Swatches -->
            <MenuItem x:Name="AccentColorMenuItem" Header="HUD Accent Color">
                <MenuItem Header="Electric Cyan" Click="AccentColor_Click" Tag="#00F0FF" IsChecked="True">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16" CornerRadius="3" Background="#00F0FF" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Matrix Green" Click="AccentColor_Click" Tag="#00FF66">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16" CornerRadius="3" Background="#00FF66" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Synthwave Magenta" Click="AccentColor_Click" Tag="#FF007F">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16" CornerRadius="3" Background="#FF007F" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Solar Amber" Click="AccentColor_Click" Tag="#FFB000">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16" CornerRadius="3" Background="#FFB000" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Phosphor White" Click="AccentColor_Click" Tag="#F0F0F0">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16" CornerRadius="3" Background="#F0F0F0" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Glitch Red" Click="AccentColor_Click" Tag="#FF2244">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16" CornerRadius="3" Background="#FF2244" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Night City Violet" Click="AccentColor_Click" Tag="#A040FF">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16" CornerRadius="3" Background="#A040FF" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Custom RGB Color..." Click="CustomColor_Click">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16" CornerRadius="3" BorderBrush="#80FFFFFF" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#00FF66" Offset="0.0"/>
                                    <GradientStop Color="#00F0FF" Offset="0.5"/>
                                    <GradientStop Color="#FF007F" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- RGB Spectrum Cycling & Speed -->
            <MenuItem x:Name="RgbCycleMenuItem" Header="RGB Spectrum Cycling" IsCheckable="True" IsChecked="False" Click="RgbCycle_Click">
                <MenuItem.Icon>
                    <Border Width="16" Height="16" CornerRadius="3" BorderBrush="#80FFFFFF" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF0055" Offset="0.0"/>
                                <GradientStop Color="#FFE600" Offset="0.33"/>
                                <GradientStop Color="#00FF66" Offset="0.66"/>
                                <GradientStop Color="#00F0FF" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem StaysOpenOnClick="True">
                <MenuItem.Header>
                    <StackPanel Width="220" Margin="0,2">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="RGB Cycle Speed" FontWeight="SemiBold"/>
                            <TextBlock x:Name="RgbCycleSpeedValueText" Text="1.0x" DockPanel.Dock="Right" Foreground="#666666"/>
                        </DockPanel>
                        <Slider x:Name="RgbCycleSpeedSlider"
                                Minimum="0.2" Maximum="3.0" Value="1.0"
                                SmallChange="0.1" LargeChange="0.5"
                                Margin="0,6,0,2"
                                PreviewMouseWheel="Slider_PreviewMouseWheel"
                                ValueChanged="RgbCycleSpeedSlider_ValueChanged"/>
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <Separator/>

            <!-- Visual Effects Suite -->
            <MenuItem x:Name="EffectsMenuItem"
                      Header="Visual FX Suite"
                      StaysOpenOnClick="True"
                      MouseEnter="EffectsMenuItem_MouseEnter"
                      MouseLeave="EffectsMenuItem_MouseLeave"
                      SubmenuOpened="EffectsMenuItem_SubmenuOpened"
                      SubmenuClosed="EffectsMenuItem_SubmenuClosed">

                <!-- Cyberpunk Rainbow Border -->
                <MenuItem x:Name="RainbowBorderMenuItem"
                          Header="Cyberpunk Rainbow Border"
                          IsCheckable="True"
                          IsChecked="False"
                          StaysOpenOnClick="True"
                          Click="RainbowBorder_Click"/>
                <MenuItem StaysOpenOnClick="True">
                    <MenuItem.Header>
                        <StackPanel Width="200" Margin="0,2">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="Border Width" FontWeight="SemiBold"/>
                                <TextBlock x:Name="BorderWidthValueText" Text="4px" DockPanel.Dock="Right" Foreground="#666666"/>
                            </DockPanel>
                            <Slider x:Name="BorderWidthSlider"
                                    Minimum="1" Maximum="16" Value="4"
                                    SmallChange="1" LargeChange="2"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Margin="0,6,0,2"
                                    PreviewMouseWheel="Slider_PreviewMouseWheel"
                                    ValueChanged="BorderWidthSlider_ValueChanged"/>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <Separator/>

                <!-- Vintage CRT Scanlines -->
                <MenuItem x:Name="CrtScanlinesMenuItem"
                          Header="Vintage CRT Scanlines"
                          IsCheckable="True"
                          IsChecked="False"
                          StaysOpenOnClick="True"
                          Click="CrtScanlines_Click"/>
                <MenuItem StaysOpenOnClick="True">
                    <MenuItem.Header>
                        <StackPanel Width="200" Margin="0,2">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="Scanline Thickness" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ScanlineThicknessValueText" Text="3px" DockPanel.Dock="Right" Foreground="#666666"/>
                            </DockPanel>
                            <Slider x:Name="ScanlineThicknessSlider"
                                    Minimum="1" Maximum="12" Value="3"
                                    SmallChange="1" LargeChange="2"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Margin="0,6,0,2"
                                    PreviewMouseWheel="Slider_PreviewMouseWheel"
                                    ValueChanged="ScanlineThicknessSlider_ValueChanged"/>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <Separator/>

                <!-- CRT Glitch -->
                <MenuItem x:Name="CrtGlitchMenuItem"
                          Header="CRT Glitch"
                          IsCheckable="True"
                          IsChecked="False"
                          StaysOpenOnClick="True"
                          Click="CrtGlitch_Click"/>
                <MenuItem StaysOpenOnClick="True">
                    <MenuItem.Header>
                        <StackPanel Width="200" Margin="0,2">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="Glitch Chance" FontWeight="SemiBold"/>
                                <TextBlock x:Name="GlitchChanceValueText" Text="15%" DockPanel.Dock="Right" Foreground="#666666"/>
                            </DockPanel>
                            <Slider x:Name="GlitchChanceSlider"
                                    Minimum="0" Maximum="100" Value="15"
                                    SmallChange="1" LargeChange="5"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Margin="0,6,0,2"
                                    PreviewMouseWheel="Slider_PreviewMouseWheel"
                                    ValueChanged="GlitchChanceSlider_ValueChanged"/>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <Separator/>

                <!-- CRT Snow -->
                <MenuItem x:Name="CrtSnowMenuItem"
                          Header="CRT Snow"
                          IsCheckable="True"
                          IsChecked="False"
                          StaysOpenOnClick="True"
                          Click="CrtSnow_Click"/>
                <MenuItem StaysOpenOnClick="True">
                    <MenuItem.Header>
                        <StackPanel Width="200" Margin="0,2">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="Snow Strength" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SnowAmountValueText" Text="25%" DockPanel.Dock="Right" Foreground="#666666"/>
                            </DockPanel>
                            <Slider x:Name="SnowAmountSlider"
                                    Minimum="0" Maximum="100" Value="25"
                                    SmallChange="1" LargeChange="5"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Margin="0,6,0,2"
                                    PreviewMouseWheel="Slider_PreviewMouseWheel"
                                    ValueChanged="SnowAmountSlider_ValueChanged"/>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
            </MenuItem>
            <Separator/>

            <!-- Display Options -->
            <MenuItem x:Name="ShowLabelsMenuItem" Header="Show Process Blip Labels" IsCheckable="True" IsChecked="True" Click="ShowLabels_Click"/>
            <MenuItem x:Name="ShowTelemetryMenuItem" Header="Show Digital Corner HUD" IsCheckable="True" IsChecked="True" Click="ShowTelemetry_Click"/>
            <Separator/>

            <!-- Window Opacity Slider -->
            <MenuItem StaysOpenOnClick="True">
                <MenuItem.Header>
                    <StackPanel Width="220" Margin="0,2">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Window Glass Opacity" FontWeight="SemiBold"/>
                            <TextBlock x:Name="GlassOpacityValueText" Text="90%" DockPanel.Dock="Right" Foreground="#666666"/>
                        </DockPanel>
                        <Slider x:Name="GlassOpacitySlider"
                                Minimum="0.30" Maximum="1.0" Value="0.90"
                                SmallChange="0.05" LargeChange="0.10"
                                Margin="0,6,0,2"
                                PreviewMouseWheel="Slider_PreviewMouseWheel"
                                ValueChanged="GlassOpacitySlider_ValueChanged"/>
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>

            <!-- LED Brightness Slider -->
            <MenuItem StaysOpenOnClick="True">
                <MenuItem.Header>
                    <StackPanel Width="220" Margin="0,2">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="HUD Brightness" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LedBrightnessValueText" Text="100%" DockPanel.Dock="Right" Foreground="#666666"/>
                        </DockPanel>
                        <Slider x:Name="LedBrightnessSlider"
                                Minimum="0.10" Maximum="1.0" Value="1.0"
                                SmallChange="0.05" LargeChange="0.10"
                                Margin="0,6,0,2"
                                PreviewMouseWheel="Slider_PreviewMouseWheel"
                                ValueChanged="LedBrightnessSlider_ValueChanged"/>
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <Separator/>

            <!-- Window State & Control -->
            <MenuItem x:Name="AlwaysOnTopMenuItem" Header="Always on Top" IsCheckable="True" IsChecked="False" Click="AlwaysOnTop_Click"/>
            <MenuItem x:Name="ShadowMenuItem" Header="Window Shadow" IsCheckable="True" IsChecked="True" Click="Shadow_Click"/>
            <MenuItem Header="Reset Window Size (460x460)" Click="ResetSize_Click"/>
            <Separator/>

            <MenuItem Header="Close Widget" Click="CloseWidget_Click"/>
            <MenuItem Header="Exit All" Click="ExitAll_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Grid Background="#01000000">
        <!-- Main Radar Container with Shadow -->
        <Grid x:Name="MainRadarContainer" Margin="0">
            <Grid.Effect>
                <DropShadowEffect x:Name="RadarDropShadow"
                                  BlurRadius="20"
                                  ShadowDepth="4"
                                  Direction="315"
                                  Color="Black"
                                  Opacity="0.40"
                                  RenderingBias="Performance"/>
            </Grid.Effect>

            <!-- Container for Skia Canvas and strictly circularly-clipped CRT effects -->
            <Grid x:Name="ClippedRadarGrid">
                <!-- Hardware Accelerated SkiaSharp Canvas -->
                <skia:SKElement x:Name="SkiaRadarElement"
                                PaintSurface="SkiaRadarElement_PaintSurface"
                                MouseMove="SkiaRadarElement_MouseMove"
                                MouseLeave="SkiaRadarElement_MouseLeave"/>

                <!-- CRT Overlays strictly clipped to the round radar screen -->
                <Grid x:Name="CrtOverlayGrid" IsHitTestVisible="False">
                    <Grid.Clip>
                        <EllipseGeometry x:Name="CrtCircularClip"/>
                    </Grid.Clip>

                    <!-- CRT Snow Static Noise -->
                    <Image x:Name="CrtSnowOverlay"
                           Stretch="Fill"
                           Visibility="Collapsed"
                           Opacity="0.0"
                           IsHitTestVisible="False"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                    <!-- Vintage CRT Scanlines -->
                    <Rectangle x:Name="CrtScanlinesOverlay"
                               Visibility="Collapsed"
                               Opacity="0.80"
                               IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <DrawingBrush x:Name="CrtDrawingBrush" TileMode="Tile" Viewport="0,0,1,6" ViewportUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <DrawingGroup>
                                        <GeometryDrawing Brush="#00000000">
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="0,0,1,6"/>
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                        <GeometryDrawing Brush="#E0000000">
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="0,0,1,3"/>
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingGroup>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- CRT Glitch Slices Canvas -->
                    <Canvas x:Name="CrtGlitchCanvas"
                            Visibility="Collapsed"
                            IsHitTestVisible="False"
                            ClipToBounds="True"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- Circular Cyberpunk Rainbow Border -->
        <Ellipse x:Name="CyberpunkRainbowBorder"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Visibility="Collapsed"
                 IsHitTestVisible="False">
            <Ellipse.Stroke>
                <LinearGradientBrush x:Name="RainbowGradientBrush" StartPoint="0,0" EndPoint="1,1">
                    <LinearGradientBrush.RelativeTransform>
                        <RotateTransform x:Name="RainbowRotateTransform" CenterX="0.5" CenterY="0.5" Angle="0"/>
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#FF0055" Offset="0.0"/>
                    <GradientStop Color="#FF7700" Offset="0.16"/>
                    <GradientStop Color="#FFE600" Offset="0.33"/>
                    <GradientStop Color="#00FF66" Offset="0.50"/>
                    <GradientStop Color="#00F0FF" Offset="0.67"/>
                    <GradientStop Color="#7000FF" Offset="0.83"/>
                    <GradientStop Color="#FF007F" Offset="1.0"/>
                </LinearGradientBrush>
            </Ellipse.Stroke>
            <Ellipse.Effect>
                <DropShadowEffect x:Name="RainbowGlowEffect"
                                  BlurRadius="12"
                                  ShadowDepth="0"
                                  Color="#00F0FF"
                                  Opacity="0.8"
                                  RenderingBias="Performance"/>
            </Ellipse.Effect>
        </Ellipse>
    </Grid>
</Window>

